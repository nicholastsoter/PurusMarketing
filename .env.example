# Supabase — copy this file to `.env` and fill in from your Supabase project:
#   Project Settings → API → Project URL and anon/public key
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Apify — powers the "Find Leads" search. Get a token from the Apify Console
# (Settings → Integrations → API tokens). Deliberately NOT prefixed with
# VITE_: it's read only by the server-side /api/apify/* functions and must
# never end up in the client bundle.
APIFY_API_TOKEN=your-apify-api-token
